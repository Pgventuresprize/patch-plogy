{
  "description": "Jarvis: lee en voz alta cada respuesta y se calla cuando le vuelves a hablar",
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "{{CMD_HABLAR}}", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "{{CMD_CALLAR}}", "timeout": 10 } ] }
    ]
  }
}
