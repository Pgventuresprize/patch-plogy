<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF y WinForms juntos chocan con los usings implícitos: van escritos en cada archivo. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PATCH</AssemblyName>
    <RootNamespace>Patch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Marca Plogy (brand kit 02): esfera como ícono de la app y de la bandeja, Plogy Display en la ventanita. -->
    <ApplicationIcon>Marca\plogy.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>PATCH by Plogy</Product>
    <NoWarn>CS0618;CA1416</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Marca\plogy.ico" LogicalName="Patch.plogy.ico" />
    <Resource Include="Marca\PlogyDisplay-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
    <!-- Oído fino: whisper.cpp con tarjeta gráfica (Vulkan: NVIDIA, AMD e Intel) y respaldo en el procesador -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- Whisper.net publica también las librerías de Linux (58 MB) y de otras arquitecturas: la app es solo para Windows x64. -->
  <Target Name="QuitarRuntimesAjenos" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes\vulkan\linux-x64;$(PublishDir)runtimes\win-x86;$(PublishDir)runtimes\win-arm64" />
  </Target>

</Project>
