{
  "language": "spanish",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(open:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(date:*)",
      "Bash(osascript -l JavaScript scripts/agenda-mac.js)",
      "Bash(mv -n:*)",
      "PowerShell(Start-Process *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Date)",
      "PowerShell(Get-Date *)",
      "PowerShell(New-Item -ItemType Directory *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Test-Path *)",
      "Read(~/Desktop/**)",
      "Read(~/Documents/**)",
      "Read(~/Downloads/**)",
      "Edit(jarvis-config.txt)",
      "Edit(notas/**)",
      "Edit(registros/**)",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__search_events",
      "mcp__claude_ai_Google_Calendar__get_event",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "PowerShell(Remove-Item *)",
      "Read(~/.ssh/**)",
      "Read(**/.env)"
    ],
    "additionalDirectories": ["~/Desktop", "~/Documents", "~/Downloads"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#` >/dev/null\nbash \"${CLAUDE_PROJECT_DIR}/scripts/hablar.sh\"\nexit\n#> | Out-Null\npowershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/scripts/hablar.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#` >/dev/null\nbash \"${CLAUDE_PROJECT_DIR}/scripts/callar.sh\"\nexit\n#> | Out-Null\npowershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/scripts/callar.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
