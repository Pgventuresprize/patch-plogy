{
  "language": "spanish",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(open:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(date:*)",
      "Bash(mdfind:*)",
      "Bash(bash scripts/buscar.sh:*)",
      "Bash(bash scripts/leer.sh:*)",
      "Bash(osascript -l JavaScript scripts/agenda-mac.js)",
      "Bash(mv -n:*)",
      "Bash(bash scripts/organizar.sh:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(du:*)",
      "PowerShell(Start-Process *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Invoke-RestMethod \"https://api.open-meteo.com/*)",
      "PowerShell(Get-Date)",
      "PowerShell(Get-Date *)",
      "PowerShell(New-Item -ItemType Directory *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Rename-Item *)",
      "PowerShell(Test-Path *)",
      "PowerShell(.\\scripts\\buscar.ps1 *)",
      "PowerShell(.\\scripts\\leer.ps1 *)",
      "PowerShell(.\\scripts\\organizar.ps1 *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Where-Object *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Group-Object *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Format-Table *)",
      "PowerShell(Format-List *)",
      "Read(~/**)",
      "Edit(patch-config.txt)",
      "Edit(notas/**)",
      "Edit(comandos/**)",
      "Edit(registros/**)",
      "mcp__claude_ai_Spotify__search",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__search_events",
      "mcp__claude_ai_Google_Calendar__get_event",
      "mcp__claude_ai_Google_Calendar__suggest_time",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__get_draft",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__update_draft",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__download_file_content",
      "mcp__claude_ai_Google_Drive__list_shared_drives",
      "mcp__claude_ai_Google_Drive__get_shared_drive_metadata",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__claude_ai_Google_Drive__copy_file",
      "mcp__claude_ai_Google_Drive__update_file"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Clear-Content *)",
      "Read(~/AppData/**)",
      "Read(~/Library/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ],
    "additionalDirectories": ["~"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#` >/dev/null\nbash \"${CLAUDE_PROJECT_DIR}/scripts/hablar.sh\"\nexit\n#> | Out-Null\npowershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/scripts/hablar.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo `# <#` >/dev/null\nbash \"${CLAUDE_PROJECT_DIR}/scripts/callar.sh\"\nexit\n#> | Out-Null\npowershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/scripts/callar.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
